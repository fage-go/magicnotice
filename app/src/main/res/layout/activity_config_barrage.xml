<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_bg_default"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_content_round"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/barrage_tv_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/barrage_ui_num"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.zhangshuo.magicnotice.ui.view.StepSeekBar
            android:id="@+id/barrage_step_num"
            android:layout_width="200dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="20dp"
            app:bgColor="@color/base_bg_default"
            app:maxProgress="5"
            app:pointColor="@color/base_font_hint_input"
            app:progress="2"
            app:progressColor="@color/base_color_blue"
            app:radius="10dp"
            app:thumbColor="@color/base_white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_barrage_show"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_p"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_content_round"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp">

            <FrameLayout
                android:id="@+id/fl_p_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_config_barrage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/ll_p_barrage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_config_barrage_area"
                    android:orientation="vertical">

                </LinearLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/tv_p_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_config_barrage_tip"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="@string/barrage_global_p"
                android:textColor="@color/base_white"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/fl_p_screen"
                app:layout_constraintLeft_toLeftOf="@+id/fl_p_screen"
                app:layout_constraintRight_toRightOf="@+id/fl_p_screen" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_h"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_content_round"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp">

            <FrameLayout
                android:id="@+id/fl_h_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_config_barrage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/ll_h_barrage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_config_barrage_area"
                    android:orientation="vertical">

                </LinearLayout>

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_config_barrage_tip"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="@string/barrage_global_h"
                android:textColor="@color/base_white"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/fl_h_screen"
                app:layout_constraintLeft_toLeftOf="@+id/fl_h_screen"
                app:layout_constraintRight_toRightOf="@+id/fl_h_screen" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</LinearLayout>