<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/base_bg_bottom_dialog"
    android:backgroundTint="@color/base_bg_default"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:text="@string/set_ui_listener_status_dot_title"
        android:textColor="@color/base_font_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/config_cells"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:orientation="horizontal">

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/position_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            app:title="@string/special_keep_alive_position"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/color_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:focusable="true"
            app:title="@string/special_keep_alive_color"
            app:type="color" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/opacity_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:focusable="true"
            app:title="@string/special_keep_alive_opacity"
            app:type="value" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:text="@string/special_keep_alive_opacity_hint"
        android:textColor="@color/base_font_txt_sub"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="@string/special_keep_alive_confirm"
        android:textColor="@color/base_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:theme="@style/Theme.MagicNotice"
        app:backgroundTint="@color/base_font_title"
        app:cornerRadius="4dp"
        app:rippleColor="@color/base_font_txt" />
</LinearLayout>
