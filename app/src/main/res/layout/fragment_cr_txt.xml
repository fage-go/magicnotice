<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_white"
    android:orientation="vertical"
    android:paddingHorizontal="15dp">


    <com.zhangshuo.magicnotice.ui.view.FilterConfigView
        android:id="@+id/filter_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="15dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="true"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:id="@+id/ll_conditions"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_stroke"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            app:layout_constraintTop_toBottomOf="@+id/rv_tag">

            <TextView
                android:id="@+id/tv_conditions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_conditions_all"
                android:textColor="@color/base_font_title"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_conditions"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@mipmap/ic_arrow_right"
                android:backgroundTint="@color/base_font_title"
                android:rotation="90"
                app:layout_constraintBottom_toBottomOf="@+id/tv_conditions"
                app:layout_constraintLeft_toRightOf="@+id/tv_conditions"
                app:layout_constraintTop_toTopOf="@+id/tv_conditions" />

            <EditText
                android:id="@+id/et_tag"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginVertical="20dp"
                android:layout_weight="1"
                android:background="@color/base_transparent"
                android:gravity="center_vertical|left"
                android:hint="@string/txt_ui_input_hint"
                android:maxLength="16"
                android:paddingHorizontal="8dp"
                android:singleLine="true"
                android:textColor="@color/base_font_title"
                android:textColorHint="@color/base_font_hint_input"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tag_add"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/txt_ui_tag_add"
                android:textColor="@color/base_font_blue"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>