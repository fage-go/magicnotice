<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_content_round"
            app:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                app:layout_scrollFlags="scroll|enterAlways">

                <EditText
                    android:id="@+id/et_filter_keyword"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_filter"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:hint="@string/search_input_hint"
                    android:minWidth="120dp"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="@color/base_font_title"
                    android:textColorHint="@color/base_font_hint_input"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_filter_app"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_search_filter"
                    android:drawableRight="@mipmap/ic_search_down"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:singleLine="true"
                    android:text="@string/search_filter_all_app"
                    android:textColor="@color/base_font_title"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_filter_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_search_filter"
                    android:drawableRight="@mipmap/ic_search_down"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:text="@string/search_filter_all_rule"
                    android:textColor="@color/base_font_title"
                    android:textSize="14sp" />
            </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <com.zhangshuo.magicnotice.refresh.MRefreshLayout
                android:id="@+id/refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.zhangshuo.common.page.PageView
                    android:id="@+id/page_view_result"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_result"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingVertical="10dp" />
                </com.zhangshuo.common.page.PageView>
            </com.zhangshuo.magicnotice.refresh.MRefreshLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>