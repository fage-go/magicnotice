<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp">


    <LinearLayout
        android:id="@+id/barrage_ll_show"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.zhangshuo.magicnotice.barrage.BarrageView
                android:id="@+id/barrage_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="15dp"
        android:background="@color/base_white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp"
            android:text="@string/barrage_ui_show_what"
            android:textColor="@color/base_font_title"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/barrage_tv_content_type"
            app:layout_constraintLeft_toRightOf="@+id/barrage_tv_content_type"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/barrage_tv_content_type">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_content_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/barrage_ui_show_icon"
                android:theme="@style/CheckBoxTheme"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/barrage_ui_show_title"
                android:theme="@style/CheckBoxTheme"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_content_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/barrage_ui_show_txt"
                android:theme="@style/CheckBoxTheme"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </LinearLayout>

    </LinearLayout>


    <TextView
        android:id="@+id/tv_font"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingHorizontal="15dp"
        android:paddingVertical="10dp"
        android:text="@string/barrage_font_set"
        android:textColor="@color/base_font_title"
        android:textSize="16sp" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/ll_font"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp">

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_font_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_font_size"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_font_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_font_color"
            app:type="color" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_font_alpha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_font_alpha"
            app:type="value" />

    </com.google.android.flexbox.FlexboxLayout>

    <TextView
        android:id="@+id/tv_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingHorizontal="15dp"
        android:paddingVertical="10dp"
        android:text="@string/barrage_bg_set"
        android:textColor="@color/base_font_title"
        android:textSize="16sp" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/ll_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp">

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_bg_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_bg_round"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_bg_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_bg_color"
            app:type="color" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_bg_alpha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            app:layout_flexGrow="1"
            app:title="@string/barrage_bg_alpha"
            app:type="value" />

    </com.google.android.flexbox.FlexboxLayout>


    <TextView
        android:id="@+id/tv_anim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingHorizontal="15dp"
        android:paddingVertical="10dp"
        android:text="@string/barrage_anim"
        android:textColor="@color/base_font_title"
        android:textSize="16sp" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/ll_anim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp">

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_anim_enter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_anim_enter"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_anim_stay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_anim_stay"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_anim_exit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_anim_exit"
            app:type="value" />

    </com.google.android.flexbox.FlexboxLayout>

    <TextView
        android:id="@+id/tv_global"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingHorizontal="15dp"
        android:paddingVertical="10dp"
        android:text="@string/barrage_global"
        android:textColor="@color/base_font_title"
        android:textSize="16sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/ll_global"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_global_num"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_global_num"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_global_click"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_global_click"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_global_click_double"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/barrage_global_click_double"
            app:type="value" />

    </com.google.android.flexbox.FlexboxLayout>

</LinearLayout>