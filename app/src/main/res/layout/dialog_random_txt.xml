<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/base_bg_bottom_dialog"
    android:paddingBottom="15dp">

    <View
        android:id="@+id/v_line"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_dialog_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/random_txt_add"
        android:textColor="@color/base_font_title"
        android:textSize="16sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_import"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:text="@string/random_txt_import"
        android:textColor="@color/base_font_hint"
        android:textSize="16sp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_txt_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_save_picture_light"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@+id/v_line">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@mipmap/ic_launcher_round"
            app:layout_constraintBottom_toBottomOf="@+id/et_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_title" />


        <EditText
            android:id="@+id/et_title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_edt_round"
            android:gravity="center_vertical|left"
            android:hint="@string/make_scheduler_notify_title"
            android:maxLength="20"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textColor="@color/base_font_title"
            android:textColorHint="@color/base_font_hint_input"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
            app:layout_constraintLeft_toRightOf="@+id/iv_logo"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <EditText
            android:id="@+id/et_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_edt_round"
            android:gravity="left"
            android:hint="@string/make_scheduler_notify_content"
            android:minHeight="40dp"
            android:minLines="2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp"
            android:textColor="@color/base_font_txt"
            android:textColorHint="@color/base_font_hint_input"
            android:textSize="14dp"
            app:layout_constraintTop_toBottomOf="@+id/et_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_next"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginVertical="10dp"
        android:text="@string/random_txt_save"
        android:textColor="@color/base_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/base_font_title"
        app:cornerRadius="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_txt_content"
        app:rippleColor="@color/base_font_txt" />
</androidx.constraintlayout.widget.ConstraintLayout>