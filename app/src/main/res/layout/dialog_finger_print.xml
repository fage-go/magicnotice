<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#232323"
    android:gravity="center">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/base_bg_common_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="40dp"
            android:background="@mipmap/icon_fingure" />

        <TextView
            android:id="@+id/tv_figure_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/figure_lock_tip"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_figure_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/base_font_red"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_figure_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/dialog_cancel"
            android:textColor="@color/base_font_txt_sub"
            android:textSize="16sp">

        </TextView>
    </LinearLayout>
</LinearLayout>