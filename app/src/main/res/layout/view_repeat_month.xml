<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.haibin.calendarview.CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#fff"
        app:current_day_lunar_text_color="#800081FF"
        app:current_day_text_color="#0081FF"
        app:max_multi_select_size="6"
        app:calendar_height="50dp"
        app:month_view="com.zhangshuo.magicnotice.ui.view.calendar.CustomMultiMonthView"
        app:month_view_scrollable="false"
        app:month_view_show_mode="mode_only_current"
        app:other_month_lunar_text_color="#e1e1e1"
        app:other_month_text_color="#e1e1e1"
        app:scheme_text_color="#0081FF"
        app:select_mode="multi_mode"
        app:selected_lunar_text_color="#CFCFCF"
        app:selected_text_color="#ffffff"
        app:selected_theme_color="#0081FF"
        app:week_background="#fff"
        app:week_start_with="sun"
        app:week_text_color="#111111"
        app:week_view="com.zhangshuo.magicnotice.ui.view.calendar.CustomWeekView"
        app:week_view_scrollable="true" />

</FrameLayout>