<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@mipmap/ic_launcher"
        app:layout_constraintBottom_toBottomOf="@+id/et_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_title" />


    <EditText
        android:id="@+id/et_title"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/bg_edt_round"
        android:gravity="center_vertical|left"
        android:hint="@string/make_scheduler_notify_title"
        android:maxLength="20"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:textColor="@color/base_font_title"
        android:textColorHint="@color/base_font_hint_input"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
        app:layout_constraintLeft_toRightOf="@+id/iv_logo"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/et_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edt_round"
        android:gravity="left"
        android:hint="@string/make_scheduler_notify_content"
        android:minHeight="40dp"
        android:minLines="2"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        android:textColor="@color/base_font_txt"
        android:textColorHint="@color/base_font_hint_input"
        android:textSize="16dp"
        app:layout_constraintTop_toBottomOf="@+id/et_title" />
</androidx.constraintlayout.widget.ConstraintLayout>