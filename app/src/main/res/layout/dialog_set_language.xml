<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/base_bg_default"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/set_language_ui_title"
        android:textColor="@color/base_font_title"
        android:textSize="16sp"
        android:textStyle="bold" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/base_white"
            app:cardCornerRadius="8dp"
            android:layout_margin="10dp"
            app:cardElevation="4dp">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_chinese"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:paddingVertical="20dp"
                android:paddingLeft="20dp">

                <TextView
                    android:id="@+id/tv_chinese_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_language_ui_chinese"
                    android:textColor="@color/base_font_txt"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_chinese_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/set_language_ui_chinese_tip"
                    android:textColor="@color/base_font_txt_sub"
                    android:textSize="12sp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_chinese_title" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/base_white"
            app:cardCornerRadius="8dp"
            android:layout_margin="10dp"
            app:cardElevation="4dp">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_english"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:paddingVertical="20dp"
                android:paddingLeft="20dp">

                <TextView
                    android:id="@+id/tv_english_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_language_ui_english"
                    android:textColor="@color/base_font_txt"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_english_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/set_language_ui_english_tip"
                    android:textColor="@color/base_font_txt_sub"
                    android:textSize="12sp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_english_title" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>