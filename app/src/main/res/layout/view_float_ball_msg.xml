<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_msg_float"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/tv_msg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/base_font_black"
        android:textSize="14sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="标题" />

    <TextView
        android:id="@+id/tv_msg_title_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/base_font_txt_sub"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_msg_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_msg_title"
        app:layout_constraintTop_toTopOf="@+id/tv_msg_title"
        tools:text="(1/20)" />


    <TextView
        android:id="@+id/tv_msg_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/base_font_txt_sub"
        android:textSize="12sp"
        app:layout_constraintLeft_toLeftOf="@+id/tv_msg_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_msg_title"
        tools:text="内容" />

</androidx.constraintlayout.widget.ConstraintLayout>