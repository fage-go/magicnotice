<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_white">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_flash"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_flash">

        <TextView
            android:id="@+id/tv_flash_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flash_count"
            android:textColor="@color/base_font_title"
            android:textSize="16sp" />

        <com.zhangshuo.magicnotice.ui.view.StepSeekBar
            android:id="@+id/step_seek_count"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            app:bgColor="@color/base_bg_default"
            app:maxProgress="5"
            app:pointColor="@color/base_font_hint_input"
            app:progress="2"
            app:progressColor="@color/base_color_blue"
            app:radius="10dp"
            app:thumbColor="@color/base_white" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>