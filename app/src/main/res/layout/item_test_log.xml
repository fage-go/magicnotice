<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tv_rule_name" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/base_font_title" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_rule_step" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/tv_rule_reason" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textColor="@color/base_font_txt_sub" android:textSize="13sp" />
    <TextView android:id="@+id/tv_rule_toggle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:paddingVertical="6dp"
        android:background="?attr/selectableItemBackground"
        android:textColor="@color/base_font_blue" android:textSize="13sp" />
    <TextView android:id="@+id/tv_rule_detail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone"
        android:textColor="@color/base_font_txt" android:textSize="13sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="8dp" android:background="@color/base_bg_default" />
</LinearLayout>
