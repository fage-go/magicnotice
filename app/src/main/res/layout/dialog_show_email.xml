<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="275dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/base_bg_common_dialog"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="@string/show_email_tip"
        android:textColor="@color/base_font_title"
        android:textSize="20sp"
        android:textStyle="bold" />


    <EditText
        android:id="@+id/et_title"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_edt_round"
        android:gravity="center_vertical|left"
        android:hint="@string/show_email_title"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:textColor="@color/base_font_title"
        android:textColorHint="@color/base_font_hint_input"
        android:textSize="16dp"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edt_round"
        android:gravity="left"
        android:hint="@string/show_email_content"
        android:minLines="3"
        android:padding="10dp"
        android:textColor="@color/base_font_title"
        android:textColorHint="@color/base_font_hint_input"
        android:textSize="16dp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_copy_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/show_email_content_tip"
        android:textColor="@color/base_font_hint"
        android:textSize="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_open"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:text="@string/show_email_send"
        android:textColor="@color/base_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/base_font_title"
        app:cornerRadius="4dp"
        app:rippleColor="@color/base_font_txt" />

</LinearLayout>