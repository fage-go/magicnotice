<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginRight="10dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/item_keyword_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_keyword_info"
        android:paddingVertical="4dp"
        android:paddingLeft="10dp"
        android:paddingRight="18dp"
        android:text="@string/keyword_info_test"
        android:textColor="@color/base_font_blue"
        android:textSize="16sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginRight="4dp"
        android:background="@mipmap/ic_tag_close"
        android:backgroundTint="@color/base_font_hint"
        app:layout_constraintBottom_toBottomOf="@+id/item_keyword_tv"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_keyword_tv" />
</androidx.constraintlayout.widget.ConstraintLayout>