<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/base_bg_default"
        android:gravity="center"
        android:padding="20dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/base_bg_common_dialog"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_notice_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@mipmap/ic_launcher"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <com.zhangshuo.magicnotice.ui.view.ClickAndCopyTextView
                android:id="@+id/tv_notice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:paddingRight="40dp"
                android:text="@string/broadcast_notice_title"
                android:textColor="@color/base_font_title"
                android:textColorHighlight="#40AEB1BF"
                android:textIsSelectable="true"
                android:textSize="15sp"
                app:layout_constraintLeft_toRightOf="@+id/iv_notice_title"
                app:layout_constraintTop_toTopOf="@+id/iv_notice_title" />


            <com.zhangshuo.magicnotice.ui.view.ClickAndCopyTextView
                android:id="@+id/tv_notice_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/broadcast_notice_content"
                android:textColor="@color/base_font_txt"
                android:textColorHighlight="#40AEB1BF"
                android:textIsSelectable="true"
                android:textSize="14sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_notice_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/broadcast_play_status"
            android:textColor="@color/base_color_yellow"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="15dp"
        android:background="@color/base_white" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_play_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:paddingVertical="10dp"
            android:text="@string/broadcast_ui_notice"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cb_play_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:text="@string/barrage_ui_opt_cb"
            android:theme="@style/CheckBoxTheme"
            app:layout_constraintBottom_toBottomOf="@+id/tv_play_notice"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_play_notice" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tv_play_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:paddingVertical="10dp"
            android:text="@string/broadcast_ui_auto"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cb_play_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:text="@string/barrage_ui_opt_cb"
            android:theme="@style/CheckBoxTheme"
            app:layout_constraintBottom_toBottomOf="@+id/tv_play_auto"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_play_auto" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_tag">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp"
            android:text="@string/broadcast_ui_prefix"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent" />

        <EditText
            android:id="@+id/et_txt_prefix"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_marginRight="15dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_stroke"
            android:gravity="center_vertical|right"
            android:hint="@string/broadcast_ui_input"
            android:maxLength="16"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:textColor="@color/base_font_title"
            android:textColorHint="@color/base_font_hint_input"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_broad_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            android:paddingVertical="15dp"
            android:text="@string/broadcast_ui_show_what"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/barrage_tv_content_type"
            app:layout_constraintLeft_toRightOf="@+id/barrage_tv_content_type"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/barrage_tv_content_type">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_content_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/broadcast_ui_app"
                android:theme="@style/CheckBoxTheme"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/broadcast_ui_title"
                android:theme="@style/CheckBoxTheme"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_content_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/broadcast_ui_txt"
                android:theme="@style/CheckBoxTheme"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </LinearLayout>

    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/rv_tag">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp"
            android:text="@string/broadcast_ui_suffix"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent" />

        <EditText
            android:id="@+id/et_txt_suffix"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_marginRight="15dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_stroke"
            android:gravity="center_vertical|right"
            android:hint="@string/broadcast_ui_input"
            android:maxLength="16"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:textColor="@color/base_font_title"
            android:textColorHint="@color/base_font_hint_input"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_play_auto">

        <TextView
            android:id="@+id/tv_broad_config"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/broadcast_ui_engine"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_engine_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/base_color_blue"
            android:textSize="16sp"
            app:layout_constraintRight_toLeftOf="@+id/iv_engine_more"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="aaabb" />

        <ImageView
            android:id="@+id/iv_engine_more"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:background="@mipmap/ic_arrow_right"
            app:layout_constraintBottom_toBottomOf="@+id/tv_broad_config"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_broad_config" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/ll_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/tv_broad_config">

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/broadcast_volume"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/broadcast_speed"
            app:type="value" />

        <com.zhangshuo.magicnotice.ui.view.ConfigRuleTipView
            android:id="@+id/cr_pitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            app:layout_flexGrow="1"
            app:title="@string/broadcast_pitch"
            app:type="value" />

    </com.google.android.flexbox.FlexboxLayout>


</LinearLayout>