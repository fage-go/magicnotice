<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="5dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/item_tv_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/config_more_widget"
            android:textColor="@color/base_font_black"
            android:textSize="14sp" />

        <View
            android:id="@+id/item_v_widget"
            android:layout_width="10dp"
            android:layout_height="1dp"
            android:background="#80000000" />

        <TextView
            android:id="@+id/item_tv_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/config_more_shortcuts_add"
            android:textColor="@color/base_color_green"
            android:textSize="14sp" />

        <View
            android:id="@+id/item_v_shortcuts"
            android:layout_width="10dp"
            android:layout_height="1dp"
            android:background="#80000000" />

        <TextView
            android:id="@+id/item_tv_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/config_more_copy"
            android:textColor="@color/base_color_blue"
            android:textSize="14sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp"
            android:background="#80000000" />

        <TextView
            android:id="@+id/item_tv_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/config_more_preview"
            android:textColor="@color/base_color_yellow"
            android:textSize="14sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp"
            android:background="#80000000" />


        <TextView
            android:id="@+id/item_tv_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/config_more_test"
            android:textColor="@color/base_color_orange"
            android:textSize="14sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp"
            android:background="#80000000" />

        <TextView
            android:id="@+id/item_tv_del"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/config_more_delete"
            android:textColor="@color/base_font_hint"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>