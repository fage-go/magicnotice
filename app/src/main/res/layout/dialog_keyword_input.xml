<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/base_bg_bottom_dialog"
    android:paddingBottom="40dp">


    <TextView
        android:id="@+id/tv_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:text="@string/search_select_all"
        android:textColor="@color/base_font_txt"
        android:textSize="16sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_confirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:text="@string/search_select_confirm"
        android:textColor="@color/base_font_blue"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_line"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_dialog_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_all" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:nestedScrollingEnabled="true"
        app:layout_constraintTop_toBottomOf="@+id/tv_all" />

    <LinearLayout
        android:id="@+id/ll_conditions"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_input_stroke"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_tag">

        <EditText
            android:id="@+id/et_tag"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginVertical="20dp"
            android:layout_weight="1"
            android:background="@color/base_transparent"
            android:gravity="center_vertical|left"
            android:hint="@string/dialog_keyword_input"
            android:maxLength="16"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:textColor="@color/base_font_title"
            android:textColorHint="@color/base_font_hint_input"
            android:textSize="14sp"
            android:textStyle="bold" />


        <com.zhangshuo.magicnotice.ui.view.CircleColorView
            android:id="@+id/circle_color_view"
            android:layout_width="24dp"
            android:layout_height="24dp" />

        <TextView
            android:id="@+id/tv_tag_add"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/txt_ui_tag_add"
            android:textColor="@color/base_font_blue"
            android:textSize="14sp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>