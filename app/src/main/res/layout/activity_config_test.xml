<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nested_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ll_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:paddingBottom="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_select_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/cl_retain">

            <TextView
                android:id="@+id/tv_rule_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="10dp"
                android:text="@string/no_hit_rule_all_tip"
                android:textColor="@color/base_font_txt"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_notice_select"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/tv_notice_select"
                app:layout_constraintTop_toTopOf="@+id/tv_notice_select" />

            <TextView
                android:id="@+id/tv_notice_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="@string/no_hit_notice_select"
                android:textColor="@color/base_font_blue"
                android:textSize="14sp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_save_picture_light"
            android:padding="10dp">


            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_notification_avatar"
                app:layout_constraintBottom_toBottomOf="@+id/et_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/et_title" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_test_select_app"
                android:gravity="center"
                android:text="@string/no_hit_app_select"
                android:textColor="@color/base_white"
                android:textSize="8sp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
                app:layout_constraintLeft_toLeftOf="@+id/iv_logo"
                app:layout_constraintRight_toRightOf="@+id/iv_logo" />

            <EditText
                android:id="@+id/et_title"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_edt_round"
                android:gravity="center_vertical|left"
                android:hint="@string/no_hit_title_hint"
                android:maxLength="20"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:textColor="@color/base_font_title"
                android:textColorHint="@color/base_font_hint_input"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
                app:layout_constraintLeft_toRightOf="@+id/iv_logo"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <EditText
                android:id="@+id/et_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edt_round"
                android:gravity="left"
                android:hint="@string/no_hit_title_content"
                android:minHeight="40dp"
                android:minLines="2"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:textColor="@color/base_font_txt"
                android:textColorHint="@color/base_font_hint_input"
                android:textSize="14dp"
                app:layout_constraintTop_toBottomOf="@+id/et_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/cl_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_content_round"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_time_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_hit_time_select"
                android:textColor="@color/base_font_txt"
                android:textSize="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_time_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="5dp"
                android:textColor="@color/base_font_txt"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iv_time_more"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="123" />

            <ImageView
                android:id="@+id/iv_time_more"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@mipmap/ic_arrow_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/ll_config_test"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginVertical="20dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_load"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@mipmap/icon_load"
                android:backgroundTint="@color/base_font_blue"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_load"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:gravity="center"
                android:text="@string/no_hit_btn_test"
                android:textColor="@color/base_font_blue"
                android:textSize="16sp"
                android:visibility="visible" />

        </LinearLayout>


        <com.zhangshuo.common.view.MaxHeightRecyclerView
            android:id="@+id/rv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_content_round"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="10dp" />


        <TextView
            android:id="@+id/tv_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/base_font_txt"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>