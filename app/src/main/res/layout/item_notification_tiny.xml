<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="10dp">


    <ImageView
        android:id="@+id/item_iv_app_logo"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:background="@drawable/bg_notification_avatar"
        app:layout_constraintBottom_toBottomOf="@+id/item_tv_app_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_tv_app_name" />

    <TextView
        android:id="@+id/item_tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginEnd="4dp"
        android:layout_marginLeft="4dp"
        android:text="@string/item_notification_tiny_app_name"
        android:textColor="@color/base_font_txt_sub"
        android:textSize="8sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/item_iv_app_logo"
        app:layout_constraintRight_toLeftOf="@+id/item_tv_time"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:00"
        android:textColor="@color/base_font_hint"
        android:textSize="8sp"
        app:layout_constraintBottom_toBottomOf="@+id/item_tv_app_name"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_tv_app_name" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_cl_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_content_round"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@+id/item_tv_app_name">


        <ImageView
            android:id="@+id/item_iv_title"
            android:layout_width="14dp"
            android:layout_height="14dp"
            app:background="@drawable/bg_notification_avatar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.zhangshuo.magicnotice.ui.view.ClickAndCopyTextView
            android:id="@+id/item_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:paddingRight="40dp"
            android:text="@string/item_notification_tiny_title"
            android:textColor="@color/base_font_title"
            android:textColorHighlight="#40AEB1BF"
            android:textIsSelectable="true"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/item_iv_title"
            app:layout_constraintLeft_toRightOf="@+id/item_iv_title"
            app:layout_constraintTop_toTopOf="@+id/item_iv_title" />

        <com.zhangshuo.magicnotice.ui.view.ClickAndCopyTextView
            android:id="@+id/item_tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/base_font_txt"
            android:textColorHighlight="#40AEB1BF"
            android:textIsSelectable="true"
            android:textSize="10sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_tv_title"
            tools:text="内容内容" />

        <ImageView
            android:id="@+id/item_iv_picture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_tv_content"
            tools:visibility="visible" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/item_iv_tag"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginRight="2dp"
        android:background="@mipmap/ic_notice_tag"
        app:layout_constraintRight_toRightOf="@+id/item_cl_content"
        app:layout_constraintTop_toTopOf="@+id/item_cl_content" />


</androidx.constraintlayout.widget.ConstraintLayout>