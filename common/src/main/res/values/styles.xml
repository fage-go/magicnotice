<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 透明界面 -->
    <style name="base_Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/base_transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent
        </item>
    </style>

    <!-- 冷启动界面 -->
    <style name="base_Launcher" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- 基本弹窗样式-->
    <style name="base_CommonDialogStyle" parent="Theme.Design.Light.NoActionBar">
        <!--去掉默认标题、背景框，但是默认动画不去除、背景可用-->
        <item name="android:windowFrame">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="base_dialogAnimStyle" parent="base_CommonDialogStyle">
        <item name="android:windowEnterAnimation">@anim/base_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/base_dialog_exit</item>
    </style>

    <!--Dialog无动画-->
    <style name="base_DialogNoAnim">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <!--Dialog底部弹出动画-->
    <style name="base_DialogBottomUpAnim">
        <item name="android:windowEnterAnimation">@anim/base_dialog_up</item>
        <item name="android:windowExitAnimation">@anim/base_dialog_down</item>
    </style>

    <style name="base_DialogBottomSheetAnim" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
    </style>

    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- ////////// App通用UI样式汇总 ////////// -->

    <!--默认字体样式(字体14sp)-->
    <style name="base_text_default">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/base_font_black</item>
    </style>

    <style name="base_text_8sp" parent="base_text_default">
        <item name="android:textSize">8dp</item>
    </style>

    <style name="base_text_9sp" parent="base_text_default">
        <item name="android:textSize">9dp</item>
    </style>

    <style name="base_text_10sp" parent="base_text_default">
        <item name="android:textSize">10dp</item>
    </style>

    <style name="base_text_11sp" parent="base_text_default">
        <item name="android:textSize">11dp</item>
    </style>

    <style name="base_text_12sp" parent="base_text_default">
        <item name="android:textSize">12dp</item>
    </style>

    <style name="base_text_13sp" parent="base_text_default">
        <item name="android:textSize">13dp</item>
    </style>

    <style name="base_text_14sp" parent="base_text_default">
        <item name="android:textSize">14dp</item>
    </style>

    <style name="base_text_15sp" parent="base_text_default">
        <item name="android:textSize">15dp</item>
    </style>

    <style name="base_text_16sp" parent="base_text_default">
        <item name="android:textSize">16dp</item>
    </style>

    <style name="base_text_17sp" parent="base_text_default">
        <item name="android:textSize">17dp</item>
    </style>

    <style name="base_text_18sp" parent="base_text_default">
        <item name="android:textSize">18dp</item>
    </style>

    <style name="base_text_20sp" parent="base_text_default">
        <item name="android:textSize">20dp</item>
    </style>

    <style name="base_text_22sp" parent="base_text_default">
        <item name="android:textSize">22dp</item>
    </style>

    <style name="base_text_24sp" parent="base_text_default">
        <item name="android:textSize">24dp</item>
    </style>

    <style name="base_text_30sp" parent="base_text_default">
        <item name="android:textSize">30dp</item>
    </style>

    <style name="base_text_32sp" parent="base_text_default">
        <item name="android:textSize">32dp</item>
    </style>

    <style name="base_text_34sp" parent="base_text_default">
        <item name="android:textSize">34dp</item>
    </style>

    <style name="base_text_36sp" parent="base_text_default">
        <item name="android:textSize">36dp</item>
    </style>

    <style name="base_text_40sp" parent="base_text_default">
        <item name="android:textSize">40dp</item>
    </style>


    <!--分割线(水平)-->
    <style name="base_divide_line">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.4dp</item>
        <item name="android:background">@color/base_divider</item>
    </style>

    <!--分割线(垂直)-->
    <style name="base_divide_line_ver">
        <item name="android:layout_width">0.4dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/base_divider</item>
    </style>

    <!--分割块-->
    <style name="base_divide_block">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:background">@color/base_bg_default</item>
    </style>

    <!--通用边距-->
    <style name="base_block_padding_default">
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- ////////// App通用UI样式汇总 ////////// -->


    <style name="base_ProgressBar" parent="android:Widget.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/base_progressbar</item>
    </style>


    <style name="Base_dialogWindowAnim" mce_bogus="1" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/bottom_tip_dialog_enter_anim</item>
        <item name="android:windowExitAnimation">@anim/bottom_tip_dialog_exit_anim</item>
    </style>

    <style name="Base_bottomTipDialog" parent="@style/Base.V7.Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>


    <style name="NoticeStyle">
        <item name="android:windowEnterAnimation">@anim/notice_in</item>
        <item name="android:windowExitAnimation">@anim/notice_out</item>
    </style>

    <style name="dialog_pickerview" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="picker_dialog_anim" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/pickerview_slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/pickerview_slide_out_bottom</item>
    </style>


    <style name="PickerEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">22sp</item>
    </style>
</resources>